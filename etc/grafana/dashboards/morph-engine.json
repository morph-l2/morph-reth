    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 102,
      "title": "Engine API Failures",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "id": 20,
      "title": "Engine API Failure Rate (per second)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(morph_engine_new_l2_block_failures_total[$__rate_interval])",
