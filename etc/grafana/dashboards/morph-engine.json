      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(morph_engine_assemble_l2_block_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(morph_engine_assemble_l2_block_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(morph_engine_assemble_l2_block_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 13,
      "title": "validateL2Block Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(morph_engine_validate_l2_block_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(morph_engine_validate_l2_block_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(morph_engine_validate_l2_block_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p99"
