          "expr": "histogram_quantile(0.99, rate(morph_engine_new_safe_l2_block_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
